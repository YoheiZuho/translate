# =============================================================
# LLM Backend (OpenAI-compatible)
# =============================================================
# vLLM serving Hy-MT2:   http://localhost:8000/v1
# SGLang serving Hy-MT2: http://localhost:30000/v1
# Ollama:                 http://localhost:11434/v1
# LM Studio:              http://localhost:1234/v1
# OpenAI:                 https://api.openai.com/v1
OPENAI_BASE_URL=http://localhost:8000/v1

# API key (leave empty for local servers without auth)
OPENAI_API_KEY=

# Model name as known to the backend
# Hy-MT2:  tencent/Hy-MT2-7B  (vLLM/SGLang)
# Ollama:  llama3.2
# OpenAI:  gpt-4o-mini
OPENAI_MODEL=tencent/Hy-MT2-7B

# =============================================================
# Inference Parameters
# Hy-MT2-1.8B / 7B recommended: temperature=0.7, top_p=0.6, top_k=20, repetition_penalty=1.05
# Hy-MT2-30B-A3B recommended:   temperature=0.7, top_p=1.0, top_k=-1,  repetition_penalty=1.0
# =============================================================
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.6
LLM_TOP_K=20
LLM_REPETITION_PENALTY=1.05
LLM_MAX_TOKENS=4096

# =============================================================
# Server
# =============================================================
# Port (default: 5000, same as LibreTranslate)
PORT=5000

# Optional: require clients to send this key as api_key field
# Leave empty for unauthenticated access
API_KEY=

# Comma-separated language codes to expose (leave empty for all Hy-MT2 defaults)
# Example: en,ja,zh,ko,fr,de
LANGUAGES=

# LLM request timeout in seconds
REQUEST_TIMEOUT=60

DEBUG=false
